/* busca guiada */
const gd=document.getElementById('gd'),W={step:0,obj:''};
const PR={Comprar:[['Até R$ 500 mil',0,500000],['R$ 500 mil a 1 mi',500000,1000000],['R$ 1 a 2 mi',1000000,2000000],['Acima de R$ 2 mi',2000000,'']],Alugar:[['Até R$ 2.500',0,2500],['R$ 2.500 a 5.000',2500,5000],['Acima de R$ 5.000',5000,'']]};
const REG=['Centro','Zona Norte','Zona Sul','Zona Leste','Zona Oeste','Santo Inácio'];
const CO=['Piscina','Academia','Churrasqueira','Varanda','Pet friendly','Playground','Salão de festas','Elevador','Mobiliado','Segurança 24h','Espaço gourmet','Ar-condicionado','Móveis planejados','Condomínio com lazer'];
const gc=(g,v,l,on)=>`<button class="chip${on?' on':''}" data-g="${g}" data-v="${v}">${l}</button>`;
const nav=(back,next,l)=>`<div class="gn"><button class="gb" data-g="n" data-v="${back}">Voltar</button><button class="gb pri" data-g="${next==='res'?'res':'n'}" data-v="${next}">${l||'Continuar'}</button></div>`;
const rcs=r=>r.map(o=>`<div class="rc" data-id="${o[0]}" role="button" tabindex="0"><div class="th">${pi(o[0],D.indexOf(o))}</div><div><h5 class="serif">${o[0]}</h5><p>${o[2]} · ${o[3]} · ${o[10]}<br>${o[9]} m²${o[4]?' · '+o[4]+' quarto'+(o[4]>1?'s':''):''}${o[7]?' · '+o[7]+' vaga'+(o[7]>1?'s':''):''}</p><b>${brl(o[8])}${o[1]==='Alugar'?' <small>/mês</small>':''}</b></div></div>`).join('');
function resetS(){Object.assign(S,{fin:'',obra:'',q:0,s:0,b:0,v:0,txt:'',pmin:'',pmax:'',amin:'',amax:'',ord:''});S.tipo.clear();S.reg.clear();S.com.clear();W.obj=''}
function V(){pn.dataset.v='g';ga.hidden=true;gd.hidden=false;fl.hidden=true;rl.hidden=true;showRes=false;pn.querySelector('.pb').scrollTop=0}
const CM=[['Quero comprar meu primeiro imóvel',()=>{S.fin='Comprar';W.obj='morar';S.pmin=0;S.pmax=500000}],['Procuro um apartamento para minha família',()=>{S.fin='Comprar';W.obj='morar';S.tipo.add('Apartamento');S.q=3}],['Quero investir em imóveis',()=>{S.fin='Comprar';W.obj='investir'}],['Procuro um imóvel de alto padrão',()=>{S.fin='Comprar';W.obj='morar';S.pmin=1000000}],['Quero encontrar imóveis em uma região específica',()=>{}]];
const ga=document.getElementById('ga');
ga.innerHTML=`<div class="ac"><button class="ah" aria-expanded="false">Escolha um caminho<i class="tri"></i></button><div class="ab" hidden>${CM.map((c,i)=>`<button class="go" data-g="p" data-v="${i}">${c[0]}</button>`).join('')}</div></div><div class="ac"><button class="ah" aria-expanded="false">Ou prefira<i class="tri"></i></button><div class="ab" hidden><button class="go" data-g="steps">Responder a algumas perguntas</button><a class="go" href="https://api.whatsapp.com/send?text=${encodeURIComponent('Olá! Gostaria de falar com um corretor.')}" target="_blank" rel="noopener">Falar direto com um corretor</a></div></div>`;
ga.onclick=e=>{const h=e.target.closest('.ah');if(h){const o=h.getAttribute('aria-expanded')==='true';h.setAttribute('aria-expanded',String(!o));h.nextElementSibling.hidden=o;return}gd.onclick(e)};
function gHome(){resetS();fl.querySelectorAll('input').forEach(i=>i.value='');const sl=fl.querySelector('select');if(sl)sl.value='';ga.querySelectorAll('.ah').forEach(h=>{h.setAttribute('aria-expanded','false');h.nextElementSibling.hidden=true});setView(false);refresh();pn.querySelector('.pb').scrollTop=0}
function gStep(n){W.step=n;V();const pg=`<div class="gp">${[1,2,3,4,5].map(i=>`<i class="${i<=n?'on':''}"></i>`).join('')}</div>`;let b='';
if(n===1)b=`<div class="gq serif">Você procura um imóvel para…</div><div class="gs">Isso nos ajuda a mostrar as melhores opções.</div><button class="go" data-g="o" data-v="morar">Morar (comprar)</button><button class="go" data-g="o" data-v="investir">Investir</button><button class="go" data-g="o" data-v="alugar">Alugar para morar</button><div class="gn"><button class="gb" data-g="home">Voltar ao início</button></div>`;
if(n===2)b=`<div class="gq serif">Em quais regiões você gostaria de ficar?</div><div class="gs">Escolha quantas quiser. Sem escolher, mostramos todas.</div><div class="row">${REG.map(r=>gc('reg',r,r,S.reg.has(r))).join('')}</div>`+nav(1,3);
if(n===3){const k=S.fin==='Alugar'?'Alugar':'Comprar';b=`<div class="gq serif">Qual faixa de preço você deseja?</div><div class="gs">${k==='Alugar'?'Valor mensal do aluguel.':'Valor de compra.'}</div><div class="row">${PR[k].map((x,i)=>gc('pr',i,x[0],S.pmin===x[1]&&S.pmax===x[2])).join('')}</div>`+nav(2,4)}
if(n===4)b=`<div class="gq serif">Quantos quartos e vagas você precisa?</div><div class="gl">Quartos (mínimo)</div><div class="row">${[1,2,3,4].map(i=>gc('q',i,i+'+',S.q===i)).join('')}</div><div class="gl">Vagas de garagem (mínimo)</div><div class="row">${[1,2,3].map(i=>gc('v',i,i+'+',S.v===i)).join('')}</div>`+nav(3,5);
if(n===5)b=`<div class="gq serif">O que é indispensável para você?</div><div class="gs">Marque o que não pode faltar.</div><div class="row">${CO.map(c=>gc('com',c,c,S.com.has(c))).join('')}${gc('obra','Pronto para morar','Pronto para morar',S.obra==='Pronto para morar')}</div>`+nav(4,'res','Ver imóveis');
gd.innerHTML=pg+b}
function summ(n){const L=[];if(W.obj)L.push('Objetivo: '+({morar:'comprar para morar',investir:'investir',alugar:'alugar para morar'}[W.obj]));
if(S.reg.size)L.push('Regiões: '+[...S.reg].join(', '));if(S.tipo.size)L.push('Tipo: '+[...S.tipo].join(', '));
if(S.pmin||S.pmax)L.push('Faixa de preço: '+(S.pmin?'de '+brl(+S.pmin):'')+(S.pmin&&S.pmax?' ':'')+(S.pmax?'até '+brl(+S.pmax):''));
if(S.q)L.push('Quartos: '+S.q+'+');if(S.v)L.push('Vagas: '+S.v+'+');
const ind=[...S.com];if(S.obra)ind.push(S.obra);if(ind.length)L.push('Indispensáveis: '+ind.join(', '));
return 'Olá! Usei a busca do site e estas são as minhas preferências:\n'+L.map(x=>'- '+x).join('\n')+'\nEncontrei '+n+' imóvel(is) compatível(is). Pode me ajudar?'}
function gRes(){V();S.ord='';const r=list(),n=r.length,wa='https://api.whatsapp.com/send?text='+encodeURIComponent(summ(n));
gd.innerHTML=`<div class="gq serif">${n?`Encontramos ${n} imóve${n===1?'l':'is'} para você`:'Nenhum imóvel com todos os critérios'}</div><div class="gs">${n?'Toque em um imóvel para ver os detalhes.':'Ajuste as respostas ou fale com um corretor, que pode buscar outras opções.'}</div>${rcs(r)}<div class="gn cl"><a class="gb wz" href="${wa}" target="_blank" rel="noopener">Falar com um corretor</a><button class="gb" data-g="n" data-v="1">Ajustar respostas</button><button class="gb" data-g="filters">Refinar nos filtros</button></div>`}
gd.onclick=e=>{const rc=e.target.closest('.rc');if(rc)return openDetail(rc.dataset.id);const b=e.target.closest('[data-g]');if(!b)return;const g=b.dataset.g,v=b.dataset.v;
if(g==='p'){resetS();CM[+v][1]();gStep(2)}
else if(g==='steps')gStep(1);
else if(g==='filters'){setView(false);refresh()}
else if(g==='home')gHome();
else if(g==='o'){S.fin=v==='alugar'?'Alugar':'Comprar';W.obj=v;gStep(2)}
else if(g==='reg'||g==='com'){const s=S[g];s.has(v)?s.delete(v):s.add(v);b.classList.toggle('on')}
else if(g==='pr'){const k=S.fin==='Alugar'?'Alugar':'Comprar',x=PR[k][+v],same=S.pmin===x[1]&&S.pmax===x[2];S.pmin=same?'':x[1];S.pmax=same?'':x[2];gd.querySelectorAll('[data-g=pr]').forEach(c=>c.classList.toggle('on',!same&&c===b))}
else if(g==='q'||g==='v'){S[g]=S[g]===+v?0:+v;gd.querySelectorAll('[data-g='+g+']').forEach(c=>c.classList.toggle('on',S[g]===+c.dataset.v))}
else if(g==='obra'){S.obra=S.obra===v?'':v;b.classList.toggle('on',S.obra===v)}
else if(g==='n')gStep(+v);
else if(g==='res')gRes()};
/* favoritos */
const fr=document.getElementById('fr'),fb=document.getElementById('fb'),fc=document.getElementById('fc');
const HEART='<svg viewBox="0 0 24 24"><path d="M12 20s-7-4.6-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.4-7 10-7 10z"/></svg>';
function favSync(){const n=D.filter(o=>FAV.has(o[0])).length;fc.textContent=n;fc.hidden=!n;if(fr.classList.contains('open'))favRender()}
const MAPI='<span class="gmp" aria-hidden="true"></span>';
let favMode='list';const CMP=new Set();
function favRender(){[...CMP].forEach(n=>{if(!FAV.has(n))CMP.delete(n)});
if(favMode==='cmp'&&CMP.size>=2){cmpRender();return}favMode='list';
const r=D.filter(o=>FAV.has(o[0]));
if(!r.length){fb.innerHTML='<div class="nores">Você ainda não salvou nenhum imóvel.<br>Toque no coração na janela do imóvel para guardá-lo aqui.</div>';return}
const n=CMP.size,wa='https://api.whatsapp.com/send?text='+encodeURIComponent('Olá! Tenho interesse nestes imóveis que salvei no site:\n'+r.map(o=>'- '+o[0]+' ('+o[3]+')').join('\n')+'\nPode me ajudar?');
fb.innerHTML=`<div class="gs" style="margin:18px 0 0">${r.length} imóve${r.length===1?'l salvo':'is salvos'}. Marque 2 ou 3 para comparar lado a lado.</div>`+r.map(o=>{const h=rcs([o]),on=CMP.has(o[0]);return h.slice(0,-6)+`<button class="cs${on?' on':''}${on&&window.__cm===o[0]?' wv':''}${!on&&window.__um===o[0]?' un':''}" data-cmp="${o[0]}">${on?'Comparando':'Comparar'}</button><button class="ib on rm" data-rm="${o[0]}" aria-label="Remover dos favoritos">${HEART}</button></div>`}).join('')+`<div class="gn cl"><button class="gb pri" data-cgo ${n<2?'disabled':''}>Comparar${n?' ('+n+')':''}</button><a class="gb wz" href="${wa}" target="_blank" rel="noopener">Falar com um corretor sobre estes imóveis</a></div>`}
function cmpRender(){const it=D.filter(o=>CMP.has(o[0])),same=it.every(o=>o[1]===it[0][1]);
const mark=(f,min)=>{const v=it.map(f),t=min?Math.min(...v):Math.max(...v);return v.every(x=>x===t)?[]:v.map((x,i)=>x===t?i:-1).filter(i=>i>=0)};
const B={p:same?mark(o=>o[8],1):[],pm:same?mark(o=>o[8]/o[9],1):[],a:mark(o=>o[9],0),q:mark(o=>o[4],0),v:mark(o=>o[7],0)};
const row=(l,k,f,cls)=>`<div class="cpc cpl">${l}</div>`+it.map((o,i)=>`<div class="cpc${B[k]&&B[k].includes(i)?' cpb':''}${cls||''}">${f(o)}</div>`).join('');
const am=CO.filter(c=>it.some(o=>o[11].includes(c)));
const t=`<div class="cpt" style="--n:${it.length}"><div class="cpc cpl"></div>`+it.map(o=>`<div class="cpc cph" data-id="${o[0]}"><div class="th2">${pi(o[0],D.indexOf(o))}</div><b>${o[0]}</b></div>`).join('')+
row('Preço','p',o=>brl(o[8])+(o[1]==='Alugar'?'/mês':''),' cpn')+row('Preço por m²','pm',o=>brl(Math.round(o[8]/o[9])),' cpn')+row('Área','a',o=>o[9]+' m²')+row('Quartos','q',o=>o[4]||'—')+row('Suítes','',o=>o[5]||'—')+row('Banheiros','',o=>o[6]||'—')+row('Vagas','v',o=>o[7]||'—')+row('Tipo','',o=>o[2])+row('Região','',o=>o[3])+row('Finalidade','',o=>o[1]==='Alugar'?'Aluguel':'Venda')+row('Estágio','',o=>o[10])+
(am.length?`<div class="cpg">Comodidades</div>`+am.map(c=>row(c,'',o=>o[11].includes(c)?'✓':'—')).join(''):'')+`</div>`;
const wa='https://api.whatsapp.com/send?text='+encodeURIComponent('Olá! Estou comparando estes imóveis no site:\n'+it.map(o=>'- '+o[0]+' ('+o[3]+')').join('\n')+'\nPode me ajudar a escolher?');
fb.innerHTML=`<button class="gb" data-cback style="width:100%;margin-top:18px">← Voltar à lista</button><div class="gs" style="margin:12px 0 0">Os melhores valores aparecem em verde${same?'':'. Preços não são destacados porque as finalidades são diferentes'}.</div><div class="cpw">${t}</div><div class="gn cl"><a class="gb wz" href="${wa}" target="_blank" rel="noopener">Falar com um corretor sobre estes imóveis</a></div>`;fr.querySelector('.pb').scrollTop=0}
function openF(){favMode='list';CMP.clear();fr.classList.add('open');document.body.style.overflow='hidden';favRender()}
function closeF(){fr.classList.remove('open');document.body.style.overflow=''}
document.getElementById('fv').onclick=openF;document.getElementById('fx').onclick=closeF;
fr.onclick=e=>{if(e.target===fr)return closeF();
const m=e.target.closest('[data-cmp]');if(m){const n=m.dataset.cmp;if(CMP.has(n))CMP.delete(n);else if(CMP.size<3)CMP.add(n);else{const g=fb.querySelector('.gs');if(g)g.textContent='Você pode comparar até 3 imóveis por vez.';return}window.__cm=CMP.has(n)?n:null;window.__um=CMP.has(n)?null:n;favRender();window.__cm=window.__um=null;return}
if(e.target.closest('[data-cgo]')){if(CMP.size>=2){favMode='cmp';favRender()}return}
if(e.target.closest('[data-cback]')){favMode='list';favRender();return}
const x=e.target.closest('[data-rm]');if(x){FAV.delete(x.dataset.rm);CMP.delete(x.dataset.rm);try{localStorage.setItem('sis3-fav',JSON.stringify([...FAV]))}catch(er){}favSync();return}
const c=e.target.closest('.rc,.cph');if(c)openDetail(c.dataset.id)};
addEventListener('keydown',e=>{if(e.key==='Escape'&&fr.classList.contains('open')&&!dt.classList.contains('open'))closeF()});
favSync();
</script>
