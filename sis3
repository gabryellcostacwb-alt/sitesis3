<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>SIS3 Imóveis</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@200;300;400&family=Bodoni+Moda:wght@400;500&family=Poppins:wght@400;500&display=swap">
<style>
:root{--bg:#f6f4ef;--ink:#16181c;--mut:#6b6f76;--card:#d9dadc;--card2:#c4c6c9;--ac:#c9955a;--teal:#7fbcb7;--line:#1f2329;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#f6f4ef;--ink:#16181c}}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth;scroll-padding-top:env(safe-area-inset-top,0px)}
body{background:var(--bg);color:var(--ink);font-family:"Helvetica Neue",Arial,sans-serif;-webkit-font-smoothing:antialiased}
.serif{font-family:Georgia,"Times New Roman",serif;font-weight:400}
header{position:fixed;top:0;left:0;right:0;z-index:30;display:flex;justify-content:space-between;align-items:center;padding:calc(14px + env(safe-area-inset-top,0px)) 20px 14px;color:#fff;transition:.3s}
header.solid{background:rgba(246,244,239,.92);color:var(--ink);backdrop-filter:blur(10px)}
.logo{display:block;position:relative;--logo:url("data:image/png;base64,")}.logo img{position:relative;z-index:1}
.lm{position:absolute;inset:0;z-index:2;pointer-events:none;overflow:hidden;background:#7fbcb7;opacity:0;transition:opacity .7s;-webkit-mask-image:var(--logo);mask-image:var(--logo);-webkit-mask-size:100% 100%;mask-size:100% 100%;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;-webkit-mask-position:center;mask-position:center}
header.solid .lm{opacity:1}
.lb{position:absolute;border-radius:50%;filter:blur(2.5px);animation:lbf 5.4s ease-in-out infinite alternate}
.lb1,.lb3,.lb5{background:radial-gradient(circle at 40% 36%,rgba(38,108,102,1),rgba(38,108,102,.9) 38%,rgba(38,108,102,0) 70%)}
.lb2,.lb4{background:radial-gradient(circle at 40% 36%,rgba(38,108,102,1),rgba(38,108,102,.9) 38%,rgba(38,108,102,0) 70%)}
.lb1{width:22px;height:22px;left:-10px;top:-6px;--dx:64px;--dy:8px;animation-duration:5.4s}
.lb2{width:18px;height:18px;left:30px;top:2px;--dx:-52px;--dy:-10px;animation-duration:6.5s;animation-delay:-2.7s}
.lb3{width:22px;height:22px;right:-10px;bottom:-8px;--dx:-60px;--dy:-8px;animation-duration:5s;animation-delay:-3.6s}
.lb4{width:18px;height:18px;left:0;bottom:-8px;--dx:58px;--dy:-12px;animation-duration:6.1s;animation-delay:-4.5s}
.lb5{width:16px;height:16px;left:26px;top:-8px;--dx:26px;--dy:18px;animation-duration:4.3s;animation-delay:-1.8s}
@keyframes lbf{from{transform:translate(0,0) scale(.8)}to{transform:translate(var(--dx),var(--dy)) scale(1.35)}}
@media(prefers-reduced-motion:reduce){.lb{animation:none}}.logo img{display:block;height:22px;width:auto;opacity:0;transition:opacity .3s}header.solid .logo img{opacity:0}.logo::after{content:"";position:absolute;inset:0;z-index:3;pointer-events:none;background:#fff;-webkit-mask-image:var(--logo);mask-image:var(--logo);-webkit-mask-size:100% 100%;mask-size:100% 100%;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;-webkit-mask-position:center;mask-position:center;transition:opacity .3s}header.solid .logo::after{opacity:0}.logo::before{content:"";position:absolute;z-index:0;left:-18px;right:-18px;top:-14px;bottom:-14px;border-radius:50%;pointer-events:none;background:transparent;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);-webkit-mask-image:radial-gradient(closest-side,#000 45%,transparent 100%);mask-image:radial-gradient(closest-side,#000 45%,transparent 100%)}
nav{display:none;gap:28px;font-size:14px}
nav a{color:inherit;text-decoration:none;opacity:.85}
.btn{display:inline-block;padding:13px 24px;border-radius:99px;background:#fff;color:var(--ink);font-size:14px;text-decoration:none;font-weight:600}
.btn.dk{background:var(--teal);color:var(--ink)}
header .btn{padding:9px 18px;font-size:13px}
@media(min-width:760px){nav{display:flex}}
/* hero */
#hero{height:450vh;position:relative}
.stick{position:sticky;top:0;height:100vh;height:100svh;overflow:hidden;background:#0d1b2e}
canvas{width:100%;height:100%;display:block}
.dkband{display:none}
.dk .dkband{display:flex;justify-content:center;align-items:flex-start;position:sticky;margin-top:calc(min(30vw,100vh) + 116px - 450vh);margin-top:calc(min(30vw,100svh) + 116px - 450vh);height:96px;padding:0 48px;z-index:6;pointer-events:none;top:calc(min(30vw,100vh) + 116px);top:calc(min(30vw,100svh) + 116px)}
.dk .dkp{pointer-events:auto;display:flex;align-items:center;justify-content:center;background:none;border:0;box-shadow:none;padding:0;width:auto}
.dk .dkp p{display:none}
.dk .dkp .sb{padding:0;flex:none;width:390px;max-width:100%}
.dk #portfolio{padding-top:56px}
#cvb{display:none}
.dk .stick{position:sticky;background:none;overflow:visible;height:min(30vw,100vh);height:min(30vw,100svh)}
.dk .sc{z-index:3;top:calc(min(30vw,100vh) + 22px);top:calc(min(30vw,100svh) + 22px);color:#fff;text-shadow:0 1px 10px rgba(0,0,0,.55)}
.dk .sc i{background:rgba(255,255,255,.3)}
.dk .sc i:after{background:#fff}
#cvf{display:none}
.dk #cvf{display:block;position:absolute;left:-6%;width:112%;top:calc(100% - 44px);height:calc(58vh + 44px);z-index:0;pointer-events:none;opacity:var(--fo,1);filter:blur(34px);image-rendering:auto;-webkit-mask-image:linear-gradient(to bottom,#000 0%,#000 6%,rgba(0,0,0,.95) 14%,rgba(0,0,0,.84) 24%,rgba(0,0,0,.7) 34%,rgba(0,0,0,.55) 45%,rgba(0,0,0,.4) 56%,rgba(0,0,0,.27) 67%,rgba(0,0,0,.15) 78%,rgba(0,0,0,.06) 90%,rgba(0,0,0,0) 100%);mask-image:linear-gradient(to bottom,#000 0%,#000 6%,rgba(0,0,0,.95) 14%,rgba(0,0,0,.84) 24%,rgba(0,0,0,.7) 34%,rgba(0,0,0,.55) 45%,rgba(0,0,0,.4) 56%,rgba(0,0,0,.27) 67%,rgba(0,0,0,.15) 78%,rgba(0,0,0,.06) 90%,rgba(0,0,0,0) 100%)}
.dk #cv{display:block;position:relative;z-index:1;width:100%;height:100%}

.shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.35),transparent 35%,transparent 60%,rgba(0,0,0,.55))}
.hl{position:absolute;left:0;right:0;padding:0 24px;color:#fff;text-align:center;opacity:0;transition:opacity .1s}
.h1{top:18%}.h2{top:50%;transform:translateY(-50%)}.h3{bottom:12%}
.hl h1,.hl h2{font-size:clamp(34px,8vw,76px);line-height:1.05;text-shadow:0 2px 24px rgba(0,0,0,.35)}
.hl p{margin-top:14px;font-size:15px;opacity:.9;max-width:460px;margin-inline:auto;line-height:1.5}
.hl .btn{margin-top:22px}
.hint{position:absolute;bottom:calc(22px + env(safe-area-inset-bottom,0px));left:50%;transform:translateX(-50%);color:#fff;font-size:11px;letter-spacing:.2em;text-transform:uppercase;text-align:center;transition:opacity .3s}
.hint i{display:block;width:1px;height:34px;margin:8px auto 0;background:#fff;animation:dr 1.6s infinite}
@keyframes dr{0%{transform:scaleY(0);transform-origin:top}50%{transform:scaleY(1);transform-origin:top}51%{transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}
.bar{position:absolute;left:0;top:0;height:3px;background:var(--ac);width:0}
.sc{position:absolute;left:0;right:0;top:96px;display:flex;flex-direction:column;align-items:center;gap:10px;color:#fff;pointer-events:none;transition:opacity .6s;text-shadow:0 1px 12px rgba(0,0,0,.45)}
.sc span{font-size:11px;letter-spacing:.22em;text-transform:uppercase;opacity:.92}
.sc i{position:relative;width:1px;height:38px;background:rgba(255,255,255,.35);overflow:hidden}
.sc i:after{content:"";position:absolute;left:0;top:-40%;width:1px;height:40%;background:#fff;animation:hn 1.9s ease-in-out infinite}
@keyframes hn{0%{top:-40%}100%{top:100%}}
.sc.off{opacity:0}
@media(prefers-reduced-motion:reduce){.sc i:after{animation:none;top:0}}
/* sections */
section.p{padding:84px 22px;max-width:1180px;margin:auto}
.eyebrow{font-size:12px;letter-spacing:.22em;text-transform:uppercase;color:var(--mut);margin-bottom:14px}
h2.t{font-size:clamp(30px,5vw,52px);line-height:1.1;margin-bottom:18px}
.lead{color:var(--mut);line-height:1.65;max-width:560px;font-size:16px}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:28px 16px;margin-top:44px;border-top:1px solid #d8d4cb;padding-top:32px}
.stats b{display:block;font-size:50px;font-family:"Cormorant Garamond",Georgia,"Times New Roman",serif;font-weight:500;font-variant-numeric:lining-nums tabular-nums;font-feature-settings:"lnum" 1,"tnum" 1;line-height:1;margin-bottom:6px}
.stats span{font-size:13px;color:var(--mut)}
@media(min-width:760px){.stats{grid-template-columns:repeat(4,1fr)}}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin:26px 0 30px}
.chip{border:1px solid #cfcac0;background:none;padding:9px 16px;border-radius:99px;font-size:13px;color:var(--ink);cursor:pointer}
.chip.on{background:var(--teal);color:var(--ink);border-color:var(--teal)}
.grid{display:grid;gap:18px;grid-template-columns:1fr}
@media(min-width:640px){.grid{grid-template-columns:1fr 1fr}}
@media(min-width:980px){.grid{grid-template-columns:repeat(3,1fr)}}
.card{background:var(--card);border-radius:20px;overflow:hidden;opacity:0;transform:translateY(34px);transition:opacity .7s,transform .7s}
.card.in{opacity:1;transform:none}
.card.hide{display:none}
.ph{aspect-ratio:4/3;background:linear-gradient(160deg,#e4e5e7,var(--card2));display:flex;align-items:flex-end;justify-content:center;position:relative;overflow:hidden}
.ph svg{width:62%;height:82%;fill:#9a9da2;transition:transform .6s}
.card:hover .ph svg{transform:scale(1.05)}
.tag{position:absolute;top:14px;left:14px;background:rgba(255,255,255,.75);padding:6px 12px;border-radius:99px;font-size:11px;letter-spacing:.06em}
.info{padding:18px 20px 22px}
.info h3{font-size:21px;margin-bottom:6px}
.info p{font-size:13.5px;color:#55595f;line-height:1.5}
.meta{display:flex;justify-content:space-between;margin-top:14px;font-size:12px;color:#55595f;border-top:1px solid #bfc1c4;padding-top:12px}
.ct{padding:100px 22px;background:#fff}
.cta{max-width:640px;margin:auto;background:linear-gradient(145deg,rgba(255,255,255,.95),rgba(246,244,239,.7));-webkit-backdrop-filter:blur(24px);backdrop-filter:blur(24px);border:1px solid #ece9e2;box-shadow:0 20px 60px rgba(22,24,28,.08);color:var(--ink);border-radius:28px;padding:48px 26px;text-align:center}
.cta h2{font-size:clamp(28px,5vw,48px);margin-bottom:14px}
.cta p{opacity:.8;margin-bottom:26px}
footer{padding:30px 22px 40px;text-align:center;font-size:12px;color:var(--mut)}
/* busca de imóveis */
.hr{display:flex;align-items:center;gap:10px}
.sb{display:flex;justify-content:center;gap:10px;padding:48px 22px 0}
.sb+section.p{padding-top:56px}
.sb .lupa{flex:1 1 auto;max-width:300px;height:58px;justify-content:center;gap:10px;padding:0 18px;font-family:Jost,"Helvetica Neue",Arial,sans-serif;font-weight:300;font-size:16px;letter-spacing:.06em;color:var(--ink);border-color:#d6d1c6;background:linear-gradient(180deg,#fff,#efece5);box-shadow:inset 0 1px 0 #fff,0 10px 30px rgba(22,24,28,.12)}
.sb .lupa svg{width:22px;height:22px}
.sb .lupa svg .gl{display:none}
.sb .lupa::after{display:none}
.btn.wa{position:relative;display:block;width:min(100%,210px);height:40px;margin:0 auto;padding:0;overflow:hidden;border-radius:99px;background:linear-gradient(180deg,#3fd95e,#1eb83a);color:#fff;border:0;transition:filter .3s}
.btn.wa:hover{filter:brightness(.95)}
.wa .wt{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:Jost,"Helvetica Neue",Arial,sans-serif;font-weight:400;font-size:13px;letter-spacing:.12em;color:inherit;padding-left:34px}
.wa .wp{position:absolute;top:0;left:8px;width:32px;height:100%;background:none;display:grid;place-items:center}
.wa .wp svg{width:22px;height:22px;fill:#fff;stroke:none}

.lupa{position:relative;overflow:hidden;display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 18px 0 12px;border-radius:99px;border:1px solid rgba(255,255,255,.5);background:linear-gradient(180deg,rgba(255,255,255,.28),rgba(255,255,255,.08));-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);box-shadow:inset 0 1px 0 rgba(255,255,255,.55),0 4px 14px rgba(0,0,0,.18);color:inherit;font:inherit;font-size:14px;font-weight:600;letter-spacing:.02em;cursor:pointer;transition:.3s}
header.solid .lupa{border-color:#cfcac0;background:linear-gradient(180deg,#fff,#efece5);box-shadow:inset 0 1px 0 #fff,0 3px 10px rgba(22,24,28,.1)}
.lupa::after{content:"";position:absolute;top:0;bottom:0;left:-60%;width:40%;background:linear-gradient(105deg,transparent,rgba(255,255,255,.65),transparent);transform:skewX(-20deg);animation:sh 3.8s ease-in-out infinite;pointer-events:none}
@keyframes sh{0%,55%{left:-60%}100%{left:130%}}
@media(prefers-reduced-motion:reduce){.lupa::after{animation:none}}
.lupa svg{width:20px;height:20px;flex:none}
.lupa svg .gl{stroke:#fff}
header.solid .lupa svg .gl{stroke:var(--ac)}
.sr{position:fixed;inset:0;z-index:40;background:rgba(13,17,23,.55);display:none;align-items:flex-end;justify-content:center}
.sr.open{display:flex}
.pn{background:var(--bg);color:var(--ink);width:100%;max-width:760px;max-height:92vh;max-height:92dvh;border-radius:24px 24px 0 0;display:flex;flex-direction:column;overflow:hidden;animation:up .35s ease}
@keyframes up{from{transform:translateY(40px);opacity:0}}
@media(min-width:760px){.sr{align-items:center}.pn{border-radius:24px}}
.pt{display:flex;justify-content:space-between;align-items:flex-start;padding:20px 20px 14px;border-bottom:1px solid #e3dfd6}
.x{width:36px;height:36px;border-radius:50%;border:1px solid #cfcac0;background:none;font-size:22px;line-height:1;cursor:pointer;color:var(--ink)}
.pb{overflow:auto;padding:0 20px 16px;flex:1;-webkit-overflow-scrolling:touch}
.fs{padding:18px 0;border-bottom:1px solid #e3dfd6}
.fs:last-child{border-bottom:0}
.fs h4{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--mut);margin-bottom:12px;font-weight:600}
.row{display:flex;flex-wrap:wrap;gap:8px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.fi{width:100%;padding:12px 14px;border:1px solid #cfcac0;border-radius:12px;background:#fff;font:inherit;font-size:14px;color:var(--ink)}
.pf{display:flex;gap:10px;align-items:center;padding:14px 20px calc(14px + env(safe-area-inset-bottom,0px));border-top:1px solid #e3dfd6;background:var(--bg)}
.pf .btn{text-align:center}
.rc{display:flex;gap:14px;background:var(--card);border-radius:16px;padding:12px;margin-top:12px}
.rc .th{flex:0 0 96px;aspect-ratio:1;border-radius:12px;background:linear-gradient(160deg,#e4e5e7,var(--card2));display:flex;align-items:flex-end;justify-content:center;overflow:hidden}
.rc .th svg{width:60%;height:80%;fill:#9a9da2}
.rc h5{font-size:18px;font-weight:400;margin-bottom:4px}
.rc p{font-size:12.5px;color:#55595f;line-height:1.5}
.rc b{display:block;margin-top:8px;font-size:16px}
.rc b small{font-size:12px;font-weight:400;color:#55595f}
.nores{padding:40px 10px;text-align:center;color:var(--mut);line-height:1.6}
/* detalhe do imóvel */
.card,.rc{cursor:pointer}
.dt{position:fixed;inset:0;z-index:60;background:rgba(13,17,23,.6);display:none;align-items:center;justify-content:center;padding:10px}
.dt.open{display:flex}
.dw{background:var(--bg);color:var(--ink);width:min(100%,1000px);height:min(760px,calc(100vh - 20px));height:min(760px,calc(100dvh - 20px));border-radius:24px;overflow:hidden;display:flex;flex-direction:column;animation:up .35s ease;position:relative}
.dimg{position:relative;flex:none;height:210px;background:linear-gradient(160deg,#e4e5e7,var(--card2));display:flex;align-items:flex-end;justify-content:center;overflow:hidden}
.dimg>svg{width:42%;height:84%;fill:#9a9da2}
.dtop{position:absolute;top:12px;left:12px;right:12px;display:flex;justify-content:space-between}
.dtop div{display:flex;gap:8px}
.ib{width:38px;height:38px;border-radius:50%;border:0;background:rgba(255,255,255,.88);display:grid;place-items:center;cursor:pointer;color:var(--ink);padding:0}
.ib svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.ib.on svg{fill:#4f9690;stroke:#4f9690}
.dbody{display:flex;flex-direction:column;flex:1;min-height:0}
.dsc{overflow:auto;flex:1;padding:20px 22px;-webkit-overflow-scrolling:touch}
.dsc .tg{display:inline-block;font-size:11px;letter-spacing:.08em;background:var(--card);padding:5px 12px;border-radius:99px;margin-bottom:12px}
.dsc h3{font-size:clamp(26px,4vw,36px);line-height:1.1;margin-bottom:6px}
.dsc .lc{color:var(--mut);font-size:14px}
.dsc .pc{font-size:26px;margin:14px 0 18px}
.dsc .pc small{font-size:13px;color:var(--mut);font-family:system-ui,sans-serif}
.sp{display:grid;grid-template-columns:repeat(3,minmax(0,102px));gap:10px;margin-bottom:6px}
.sp div{background:var(--card);border-radius:14px;padding:12px;text-align:center;font-size:11px;letter-spacing:.06em;color:#55595f;text-transform:uppercase}
.sp b{display:block;font-size:20px;color:var(--ink);letter-spacing:0;font-weight:400;font-family:Georgia,serif;margin-bottom:2px}
.dsc h4{font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--mut);margin:20px 0 10px;font-weight:600}
.dsc p.ds{line-height:1.65;color:#3a3e44;font-size:15px}
.dact{padding:14px 22px calc(14px + env(safe-area-inset-bottom,0px));border-top:1px solid #e3dfd6;background:var(--bg);display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px}
.dact a,.dact button{display:flex;align-items:center;justify-content:center;gap:8px;height:46px;border-radius:99px;font:inherit;font-size:14px;font-weight:600;text-decoration:none;cursor:pointer;border:1px solid #cfcac0;background:none;color:var(--ink)}
.dact svg{width:18px;height:18px;flex:none;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.dact .vk{grid-column:1/-1;background:var(--teal);color:var(--ink);border:0}
.dact .wz{background:linear-gradient(180deg,#3fd95e,#1eb83a);color:#fff;border:0}
.dact .wz svg{fill:#fff;stroke:none}
.dact .wz,.dact a{grid-column:1/-1}
.dact .wz{height:56px;overflow:hidden;gap:0}
.vw{margin-left:6px}
.ag{position:relative;display:inline-flex;align-items:center;padding:0;height:40px}
.ag span{position:relative;z-index:1}
.dact .wz .cl{position:absolute;left:50%;top:50%;width:74px;height:44px;transform:translate(-50%,-50%);fill:none;stroke:#fff;stroke-width:1;stroke-linecap:round;stroke-linejoin:round;opacity:.85}
.vf{display:none;background:var(--card);border-radius:16px;padding:16px;margin-top:18px}
.vf.open{display:block}
.vf .two,.vf .fi{margin-bottom:10px}
.vf .two .fi{margin:0}
.vf .er{color:#b3261e;font-size:13px;min-height:18px;margin-bottom:8px}
.vf .ok{line-height:1.6}
.vf .cf{width:100%;height:44px;border-radius:99px;border:0;background:var(--teal);color:var(--ink);font:inherit;font-weight:600;cursor:pointer}
.tst{position:absolute;left:50%;bottom:90px;transform:translateX(-50%);background:var(--teal);color:var(--ink);padding:10px 18px;border-radius:99px;font-size:13px;opacity:0;transition:opacity .3s;pointer-events:none;white-space:nowrap}
.tst.show{opacity:1}
/* busca guiada */
.pn[data-v=g] .pf{display:none}
.gq{font-size:clamp(24px,5vw,30px);line-height:1.15;margin:20px 0 6px}
.gs{color:var(--mut);font-size:14px;margin-bottom:16px;line-height:1.5}
.gp{display:flex;gap:6px;margin-top:16px}
.gp i{flex:1;height:3px;border-radius:2px;background:#d9d5cb}
